<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/browser_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/toolbar_background"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/browser_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/securityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/security_badge_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/secure"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/addressInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/address_bar_background"
            android:hint="@string/address_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/browser_text"
            android:textColorHint="@color/browser_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/nav_button_background"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@color/browser_text" />

            <ImageButton
                android:id="@+id/forwardButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/nav_button_background"
                android:contentDescription="@string/forward"
                android:padding="12dp"
                android:src="@android:drawable/ic_media_next"
                android:tint="@color/browser_text" />

            <ImageButton
                android:id="@+id/refreshButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/nav_button_background"
                android:contentDescription="@string/refresh"
                android:padding="12dp"
                android:src="@android:drawable/ic_popup_sync"
                android:tint="@color/browser_text" />

            <ImageButton
                android:id="@+id/homeButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/nav_button_background"
                android:contentDescription="@string/home"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_view"
                android:tint="@color/browser_text" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:indeterminate="false"
            android:max="100"
            android:progressTint="@color/accent" />
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
